/**
 * Generates core/.../blockstate/BlockstateData.java from Capella's
 * src/core/generated/blockstate-data.ts (the parts the Java port reads:
 * PROPERTY_DOMAINS and INVARIANT_PROPS).
 *
 * Rerun from a checkout of the gothic generator (tjhgibbs-git/mc-gothic-generator), with this
 * repo beside it:
 *
 *     cd ../mc-gothic-generator && pnpm install
 *     npx tsx ../capella-fabric/tools/gen-blockstate-data.mts
 */
import { writeFileSync } from 'node:fs';
import { join, resolve } from 'node:path';

const gothic = process.cwd();
const out = resolve(gothic, '../capella-fabric/core/src/main/java/io/github/tjhgibbs/capella/core/blockstate/BlockstateData.java');
const data = await import(join(gothic, 'src/core/generated/blockstate-data.ts'));

const q = (s: string) => JSON.stringify(s);
const lines: string[] = [];
lines.push('package io.github.tjhgibbs.capella.core.blockstate;');
lines.push('');
lines.push('import java.util.List;');
lines.push('import java.util.Map;');
lines.push('import java.util.Set;');
lines.push('');
lines.push('/**');
lines.push(' * GENERATED by tools/gen-blockstate-data.mts from Capella\'s generated/blockstate-data.ts');
lines.push(` * (minecraft-data ${data.MC_DATA_VERSION}). Do not hand-edit; rerun the script.`);
lines.push(' */');
lines.push('public final class BlockstateData {');
lines.push('    private BlockstateData() {');
lines.push('    }');
lines.push('');
lines.push(`    public static final String MC_DATA_VERSION = ${q(data.MC_DATA_VERSION)};`);
lines.push('');
lines.push('    /** Every legal value observed for a property name, across every block that carries it. */');
lines.push('    public static final Map<String, List<String>> PROPERTY_DOMAINS = Map.ofEntries(');
const entries = Object.entries(data.PROPERTY_DOMAINS as Record<string, string[]>);
entries.forEach(([k, v], i) => {
  lines.push(`            Map.entry(${q(k)}, List.of(${v.map(q).join(', ')}))${i < entries.length - 1 ? ',' : ''}`);
});
lines.push('    );');
lines.push('');
lines.push('    /** Properties a rotation or mirror leaves unchanged. */');
lines.push(`    public static final Set<String> INVARIANT_PROPS = Set.of(${[...(data.INVARIANT_PROPS as Set<string>)].map(q).join(', ')});`);
lines.push('}');
writeFileSync(out, lines.join('\n') + '\n');
console.log('wrote', out, entries.length, 'properties');
